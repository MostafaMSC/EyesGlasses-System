# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python microservice (services/frame-processor)
services/frame-processor/venv/
services/frame-processor/__pycache__/
services/frame-processor/*.pyc

# 3D frame models dropped in the project root while being prepared for
# upload. Raw generator output runs tens of MB, and these are uploaded
# through /admin rather than served from the repo — only the root is
# ignored, so a deliberate asset under public/ can still be committed.
/*.glb
/*.gltf
