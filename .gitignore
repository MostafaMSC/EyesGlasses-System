# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template carries no secrets and is what tells you which vars to set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python microservice (services/frame-processor)
services/frame-processor/venv/
services/frame-processor/__pycache__/
services/frame-processor/*.pyc

# 3D frame models. Raw generator output runs tens of megabytes and gets
# optimised locally before it is used, so scratch models are ignored wherever
# they land — except under public/, which is exactly where a model the site
# actually serves belongs (see README, "Where the model file lives").
*.glb
*.gltf
!public/**/*.glb
!public/**/*.gltf
