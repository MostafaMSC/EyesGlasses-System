# Copy to .env and fill in before `docker compose up`. Compose reads .env
# automatically; it is gitignored, so real values never reach the repo.
#
#   cp .env.example .env
#
# Generate the two secrets rather than inventing them, e.g.:
#   openssl rand -base64 24

# Password for Postgres. Compose refuses to start without it. Any characters
# are safe — it is handed to the driver as its own field, never spliced into
# a connection string.
POSTGRES_PASSWORD=

# Password for /admin. At least 8 characters, or the panel stays disabled.
# Anyone with this can edit the live catalogue.
ADMIN_PASSWORD=

# Host port the app is published on. Set this to whatever an existing reverse
# proxy already forwards to, and no proxy config has to change.
# WEB_PORT=3000

# Interface to publish on. Loopback is right behind a proxy on the same
# machine. Widen it only if the proxy reaches the app as `localhost` and
# resolves that to IPv6 (a 127.0.0.1 binding never answers ::1), or if the
# proxy runs on another host.
# WEB_HOST=127.0.0.1

# Optional — only change these on a fresh volume. Editing them after the
# database has been created points the app at a user/database that does not
# exist, because Postgres only applies them when it first initialises.
# POSTGRES_USER=abuthar
# POSTGRES_DB=abuthar
